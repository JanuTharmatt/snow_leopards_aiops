# ================================================================
# SNOW LEOPARDS — Autonomous AIOps & Observability Cloud
# Environment Configuration Template (.env)
# ================================================================

# SaaS Server Core
SAAS_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000
AIOPS_SSL_ENABLED=0

# Cryptographic Token & JWT Signing
JWT_SECRET_KEY=AIOPS_JWT_SIGNING_KEY_2026_PRIVACY_SECURE
JWT_ALGORITHM=HS256
JWT_DEFAULT_EXPIRY_SECONDS=900

# Google Cloud Firestore & Firebase Credentials (Optional / Dual-Mode)
# If provided, platform persists documents to live Google Cloud Firestore.
# If omitted, platform seamlessly runs in high-performance local SQLite mode.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CONFIG_PATH=

# Firebase Client Web SDK Config (for standalone frontend)
REACT_APP_FIREBASE_API_KEY=AIzaSyDEMO-KEY-SNOWLEOPARDS-2026
REACT_APP_FIREBASE_AUTH_DOMAIN=snow-leopards-aiops.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=snow-leopards-aiops
REACT_APP_FIREBASE_STORAGE_BUCKET=snow-leopards-aiops.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=1029384756
REACT_APP_FIREBASE_APP_ID=1:1029384756:web:abcdef123456

# Collector Configuration Defaults
COLLECTOR_ID=COLL-001
TENANT_ID=TENANT-001
COLLECTOR_SECRET=SECRET-COLL-DEMO-001
HEADLESS_ONBOARDING=0
